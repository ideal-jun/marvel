<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.marvel</groupId>
        <artifactId>marvel-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-infra</artifactId>
    <name>module-infra</name>
    <description>基础设施域：文件/任务/监控（未来拆为 infra 服务）</description>

    <dependencies>
        <!-- 单元测试：JUnit5 / Mockito / AssertJ / spring-test（test scope，不进入产物） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.marvel</groupId>
            <artifactId>marvel-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.marvel</groupId>
            <artifactId>marvel-framework</artifactId>
        </dependency>
        <!-- MinIO 对象存储（可用 marvel.storage.type=minio 切换） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
