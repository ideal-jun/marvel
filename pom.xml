<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.marvel</groupId>
    <artifactId>marvel</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>marvel</name>
    <description>Marvel 后台管理系统（模块化单体，面向 Spring Cloud 演进）</description>

    <modules>
        <module>marvel-common</module>
        <module>marvel-api</module>
        <module>marvel-framework</module>
        <module>marvel-modules</module>
        <module>marvel-gateway-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sa-token.version>1.46.0</sa-token.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <minio.version>8.5.17</minio.version>
        <!-- OpenAPI/Swagger 有意不启用：避免对外暴露完整接口与权限模型（渗透测试基线）。
             如需本地调试，可临时引入 org.springdoc:springdoc-openapi-starter-webmvc-ui:3.1.1
             并放在 dev profile 中，切勿在生产公开 /v3/api-docs 与 /swagger-ui。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 版本对齐：Sa-Token BOM 把 spring-web 钉在 7.0.3，与 Boot 4.1.1 管理的其余
                 Spring Framework（${spring-framework.version}）错配——spring-webmvc 的
                 SseEmitter 依赖 spring-web 的 SseUtils，版本落后会让 SSE 端点抛
                 NoClassDefFoundError。显式对齐到 Boot 管理版本（管理项置于 import 之前才能覆盖 BOM） -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-web</artifactId>
                <version>${spring-framework.version}</version>
            </dependency>
            <!-- 安全修复：Sa-Token 1.46.0 BOM 把 Jackson2 降到 jackson-databind 2.13.4.1
                 （CVE-2022-42003 / CVE-2022-42004）与 jackson-datatype-jsr310 2.11.2。
                 显式管理项放在 import 之前，以覆盖导入 BOM 的同名管理项。 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.21.5</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>2.21.5</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-dependencies</artifactId>
                <version>${sa-token.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marvel</groupId>
                <artifactId>marvel-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marvel</groupId>
                <artifactId>system-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marvel</groupId>
                <artifactId>marvel-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marvel</groupId>
                <artifactId>module-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marvel</groupId>
                <artifactId>module-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marvel</groupId>
                <artifactId>module-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <layers><enabled>true</enabled></layers>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- ===================== 软件成分分析（SCA）=====================
         用法：mvn -DskipTests -Psecurity-scan verify
         产物：target/bom.json（CycloneDX SBOM）
               target/dependency-check/（OWASP dependency-check HTML/JSON 报告）
         CI 建议配置 NVD_API_KEY（https://nvd.nist.gov/developers/request-an-api-key），
         未配置时 NVD 数据更新受限、扫描更慢。
         本地只跑 SBOM 可用：mvn -Psecurity-scan verify -Ddependency-check.skip=true -->
    <profiles>
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <!-- 仅在聚合根执行，避免每个子模块重复生成 -->
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>make-sbom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <projectType>application</projectType>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <!-- 仅在聚合根执行 -->
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>aggregate-scan</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <formats>HTML,JSON</formats>
                            <suppressionFiles>
                                <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
